              "url": "https://raw.githubusercontent.com/suttacentral/bilara-data/published/root/pli/ms/sutta/dn/dn16_root-pli-ms.json",
              "segment": "dn16:3.7.2",
              "pali_excerpt": "“parinibbātu dāni, bhante, bhagavā, parinibbātu sugato, parinibbānakālo dāni, bhante, bhagavato."
